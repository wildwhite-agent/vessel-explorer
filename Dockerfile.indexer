FROM node:24.22.1-alpine AS base
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@10.32.1 --activate
WORKDIR /app/indexer

FROM base AS deps
COPY indexer/package.json indexer/pnpm-lock.yaml ./
COPY indexer/patches ./patches
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY indexer ./
RUN pnpm codegen

FROM base AS production
COPY --from=build --chown=node:node /app/indexer ./
RUN chown node:node /app/indexer
USER node
EXPOSE 42069
CMD ["sh", "scripts/start-production.sh"]
